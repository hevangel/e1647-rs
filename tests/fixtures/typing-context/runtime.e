type mode_t: [active_mode, idle_mode];
template struct box_t of <type> { !value: <type>; };
struct packet_s {
    !n: uint = 0;
};
type packet_alias_t: packet_s;
struct api_s {
    static !sn: uint = 0;
    static !calls: uint = 0;
    static !index_calls: uint = 0;
    !mode: mode_t = active_mode;
    when active_mode'mode { !extra: uint; };
    !n: uint = 0;
    accept(v: uint): uint is { return v; };
    take(p: packet_s): uint is { return p.n; };
    make(): packet_s is { api_s::calls = api_s::calls + 1; return new with { n = 8; }; };
    index(): uint is { api_s::index_calls = api_s::index_calls + 1; return 0; };
    own_context(): uint is {
        me.n = evaluate { value = 25; };
        return self.accept(evaluate { value = me.n; });
    };
    evaluated(): uint is { return evaluate { value = 9; }; };
    static format(v: uint): string is { return v.to_string(); };
    static make_static(): packet_s is { return new with { n = 10; }; };
};
extend sys {
    // Inferred locals must shadow fields during context lookup too.
    !worker: uint = 0;
    !inferred_list: string = "field";
    api: api_s;
    run() is also {
        var n: uint = evaluate { value = 1; };
        n = evaluate { value = 2; };
        check that n == 2;
        var p: packet_s = (new with { n = 3; });
        check that p.n == 3;
        p = TRUE ? new with { n = 4; } : new with { n = 99; };
        check that p.n == 4;
        var q: packet_s;
        q = new with { n = 5; };
        check that q.n == 5;
        var packets: list of packet_s = { new packet_s; };
        packets[0] = new with { n = 6; };
        check that packets[0].n == 6;
        var ns: list of uint = { 0; };
        ns[0] = evaluate { value = 7; };
        check that ns[0] == 7;
        api_s::sn = evaluate { value = 8; };
        check that api_s::sn == 8;
        api.n = evaluate { value = 9; };
        check that api.n == 9;
        check that api.take(new with { n = 10; }) == 10;
        check that api.accept(evaluate { value = 11; }) == 11;
        var worker := new api_s;
        check that worker.accept(evaluate { value = 12; }) == 12;
        var made: packet_s = api.make();
        check that made.n == 8;
        check that api.evaluated() == 9;
        check that api_s::make_static().n == 10;
        var rendered: string = api_s::format(evaluate { value = 13; });
        check that rendered == "13";
        var inferred := 1;
        inferred = evaluate { value = 14; };
        check that inferred == 14;
        var counted: uint = ns.count(evaluate { value = it > 0; });
        check that counted == 1;
        var alias: packet_alias_t = new with { n = 15; };
        check that alias.n == 15;
        var inferred_list := { 1; 2; };
        inferred_list = evaluate { value = { 3; 4; }; };
        check that inferred_list[1] == 4;
        var constructed: list of packet_s = { new with { n = 16; }; { new with { n = 17; }; }; };
        check that constructed[1].n == 17;
        api.make().n = evaluate { value = 19; };
        check that api_s::calls == 2;
        ns[api.index()] = evaluate { value = 20; };
        check that api_s::index_calls == 1;
        check that ns[0] == 20;
        check that api.active_mode'accept(evaluate { value = 21; }) == 21;
        var box: box_t of (uint) = new with { value = 22; };
        check that box.value == 22;
        var wide := 4294967296;
        var unchanged := wide + 1;
        check that unchanged == 4294967297;
        check that (TRUE ? api : worker).accept(evaluate { value = 23; }) == 23;
        check that { worker; api; }[0].accept(evaluate { value = 24; }) == 24;
        check that api.own_context() == 25;
        out("context scopes passed");
    };
};
